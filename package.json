{
  "name": "ragnarokoffline",
  "productName": "Ragnarok Offline",
  "version": "1.0.5",
  "description": "Ragnarok Online, offline, in one app",
  "license": "GPL-3.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chronotale.ragnarokoffline",
    "productName": "Ragnarok Offline",
    "copyright": "GPL-3.0",
    "directories": {
      "output": "dist/electron",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "!**/node_modules/**",
      "!electron/vc_redist.x64.exe",
      "!electron/installer.nsh"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "LSMinimumSystemVersion": "13.0"
      },
      "signIgnore": [
        "payload/bin/"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "electron/installer.nsh"
    },
    "afterPack": "electron/afterPack.js"
  }
}
