+/*==========================================
+ * Mod channel (mod_channel.cpp; server extension mod_channel). The commands warn and do nothing while it is off.
+ *
+ * modchannel "<channel>", "<NPC>::<On label>"{, <flags>};
+ *   A client packet on that channel runs the label right away with no player attached (also while the player is in
+ *   an NPC dialog): .@mc_cid / .@mc_aid say who, for commands that take a char or account id. Flag 1: run it with
+ *   the player attached instead; it then waits, packet and all, while the player is in an NPC dialog. Flag 2:
+ *   attached too, but a packet that comes while the player is in an NPC dialog is dropped (polls: a late answer or
+ *   order is worse than none).
+ *   Also set: .@mc_id (request id, reply with the same), .@mc_n (values), .@mc_fmt$ (their types, as modsend's
+ *   format), .@mc_int[k] (number; an array's length), .@mc_str$[k] (string), .@mc_arr<k>[] / .@mc_arr<k>$[].
+ * modsend "<channel>", <request id>, "<format>"{, <value>...};   (to the attached player; detached: modsendto .@mc_cid)
+ * modsendto <char id>, "<channel>", <request id>, "<format>"{, <value>...};
+ *   Format, one letter per value: i number, s string, I number array, S string array (a variable, sent from index 0
+ *   to its getarraysize). 1 if sent; 0 if that player is offline or their client has no mod channel.
+ * modready({<char id>}) -> 1 if that player's client can be sent to.
+ *------------------------------------------*/
+#include "../map/mod_channel.hpp"
+
+static bool mc_off(script_state* st, const char* command)
+{
+	if( mod_channel_enabled() )
+		return false;
+	ShowWarning("%s: the server extension mod_channel is off.\n", command);
+	script_pushint(st, 0);
+	return true;
+}
+
+/// Encodes modsend's values: `fmt` from argument `arg` on. False (with an error) on a bad format or argument.
+static bool mc_encode(script_state* st, const char* command, const char* fmt, int32 arg, mod_channel::writer& w)
+{
+	for( const char* f = fmt; *f != '\0'; ++f, ++arg ){
+		if( !script_hasdata(st, arg) ){
+			ShowError("%s: format \"%s\" wants more values.\n", command, fmt);
+			return false;
+		}
+		switch( *f ){
+			case 'i': w.num(script_getnum64(st, arg)); break;
+			case 's': w.str(script_getstr(st, arg)); break;
+			case 'I':
+			case 'S': {
+				script_data* data = script_getdata(st, arg);
+				if( !data_isreference(data) ){
+					ShowError("%s: value %d (%c) must be an array variable.\n", command, (int32)(f - fmt) + 1, *f);
+					return false;
+				}
+				const char* name = reference_getname(data);
+				if( is_string_variable(name) != (*f == 'S') ){
+					ShowError("%s: value %d is %s array, the format says %c.\n", command, (int32)(f - fmt) + 1, is_string_variable(name) ? "a string" : "a number", *f);
+					return false;
+				}
+				map_session_data* vsd = nullptr;
+				if( not_server_variable(*name) && !script_rid2sd(vsd) )
+					return false;
+				uint32 id = reference_getid(data);
+				uint32 count = script_array_highest_key(st, vsd, name, reference_getref(data));
+				if( *f == 'I' ){
+					w.array(mod_channel::T_INT_ARRAY, count);
+					for( uint32 i = 0; i < count; i++ )
+						w.i32((int32)get_val2_num(st, reference_uid(id, i), reference_getref(data)));
+				}else{
+					w.array(mod_channel::T_STR_ARRAY, count);
+					for( uint32 i = 0; i < count; i++ ){
+						w.raw_str(get_val2_str(st, reference_uid(id, i), reference_getref(data)));
+						script_removetop(st, -1, 0);
+					}
+				}
+				break;
+			}
+			default:
+				ShowError("%s: unknown format letter '%c' in \"%s\" (i, s, I, S).\n", command, *f, fmt);
+				return false;
+		}
+	}
+	if( script_hasdata(st, arg) )
+		ShowWarning("%s: more values than format \"%s\" says; the rest are not sent.\n", command, fmt);
+	if( !w.fits() ){
+		ShowError("%s: the values are more than %d bytes.\n", command, (int32)mod_channel::MAX_PACKET);
+		return false;
+	}
+	return true;
+}
+
+/// modsend / modsendto from argument `first` (the channel) on.
+static int32 mc_send(script_state* st, const char* command, map_session_data* sd, int32 first)
+{
+	const char* channel = script_getstr(st, first);
+	uint32 request = (uint32)script_getnum64(st, first + 1);
+	const char* fmt = script_getstr(st, first + 2);
+	mod_channel::writer w;
+
+	if( !mc_encode(st, command, fmt, first + 3, w) ){
+		script_reportsrc(st);
+		script_pushint(st, 0);
+		return SCRIPT_CMD_FAILURE;
+	}
+	script_pushint(st, mod_channel_send(sd, channel, request, w.buf) ? 1 : 0);
+	return SCRIPT_CMD_SUCCESS;
+}
+
+BUILDIN_FUNC(modchannel)
+{
+	if( mc_off(st, "modchannel") )
+		return SCRIPT_CMD_SUCCESS;
+	const char* channel = script_getstr(st, 2);
+	int32 flags = script_hasdata(st, 4) ? script_getnum(st, 4) : 0;
+	if( !mod_channel_bind(channel, script_getstr(st, 3), flags) ){
+		ShowError("modchannel: \"%s\" is not a channel name (1-15 characters, not \"sys\" or \"ask\").\n", channel);
+		script_pushint(st, 0);
+		return SCRIPT_CMD_FAILURE;
+	}
+	script_pushint(st, 1);
+	return SCRIPT_CMD_SUCCESS;
+}
+
+BUILDIN_FUNC(modsend)
+{
+	if( mc_off(st, "modsend") )
+		return SCRIPT_CMD_SUCCESS;
+	map_session_data* sd = nullptr;
+	if( !script_rid2sd(sd) ){
+		script_pushint(st, 0);
+		return SCRIPT_CMD_SUCCESS;
+	}
+	return mc_send(st, "modsend", sd, 2);
+}
+
+BUILDIN_FUNC(modsendto)
+{
+	if( mc_off(st, "modsendto") )
+		return SCRIPT_CMD_SUCCESS;
+	return mc_send(st, "modsendto", map_charid2sd(script_getnum(st, 2)), 3);
+}
+
+BUILDIN_FUNC(modready)
+{
+	map_session_data* sd = nullptr;
+	if( script_hasdata(st, 2) )
+		sd = map_charid2sd(script_getnum(st, 2));
+	else
+		script_rid2sd(sd);
+	script_pushint(st, mod_channel_ready(sd) ? 1 : 0);
+	return SCRIPT_CMD_SUCCESS;
+}
