+// RAGNAROKMAC (shell guilds): a shell guild has just been made in memory; run what
+// castle scripts asked to run once its info arrived (they may start before the mod).
+void guild_population_defined(int32 guild_id) {
+	DBData data;
+	if (guild_infoevent_db->remove(guild_infoevent_db, db_i2key(guild_id), &data)) {
+		struct eventlist *ev = (struct eventlist *)db_data2ptr(&data), *ev2;
