diff --git a/src/custom/battle_config_struct.inc b/src/custom/battle_config_struct.inc
--- a/src/custom/battle_config_struct.inc
+++ b/src/custom/battle_config_struct.inc
@@ -21,6 +21,20 @@ int32 population_engine_enable;
 int32 population_engine_demand_spawn;
 /// How long a map keeps its shells after the last real player leaves.
 int32 population_engine_demand_grace_ms;
+/// RAGNAROKMAC (respawn control): how long a dead ambient shell lies before it stands up,
+/// rolled between min and max; skew > 1 favours the short end. 5000/5000/1 = as before.
+int32 population_engine_respawn_min_ms;
+int32 population_engine_respawn_max_ms;
+int32 population_engine_respawn_skew;
+/// RAGNAROKMAC: 1 = an ambient shell never picks a monster already fighting someone outside its party.
+int32 population_engine_no_kill_steal;
+/// RAGNAROKMAC (shell guilds): a monster's death event when a shell kills it. 0 dropped (as before),
+/// 1 runs, with the shell attached, for the Emperium and guardians (WoE), 2 for every monster.
+/// A mod turns it on with setbattleflag.
+int32 population_engine_shell_kill_events;
+/// RAGNAROKMAC (mod hooks): added to the online count /w shows (players a mod counts but
+/// does not spawn, to spare the server). 0 = the real count.
+int32 population_engine_who_extra;
 /// Percentage applied to every spawn-table population before it is
 /// distributed across a map list. 100 = exactly what the YAML asks for.
 int32 population_engine_density_pct;
diff --git a/src/custom/script.inc b/src/custom/script.inc
--- a/src/custom/script.inc
+++ b/src/custom/script.inc
@@ -408,6 +408,181 @@ BUILDIN_FUNC(companion_hire)
  *   in time, 4 went somewhere it cannot walk to. Through a portal it simply
  *   follows: it walks into the same portal a moment later. "" turns it off.
  *------------------------------------------*/
+/**
+ * RAGNAROKMAC (mod hooks): what a mod can do with the shells beyond moving them.
+ *
+ * population_face(<gid>, <body dir 0-7>{, <head 0 forward, 1 right, 2 left>})
+ *   Turns a shell's body (and head) on the spot, sitting or standing, the way a player
+ *   presses the arrow keys; everyone around sees it. 1 done, 0 not a shell.
+ */
+BUILDIN_FUNC(population_face)
+{
+	map_session_data *sd = map_id2sd(script_getnum(st, 2));
+	if (sd == nullptr || population_engine_shell_kind(sd->id) == 0) {
+		script_pushint(st, 0);
+		return SCRIPT_CMD_SUCCESS;
+	}
+	unit_setdir(sd, static_cast<uint8>(script_getnum(st, 3) & 7), false);
+	if (script_hasdata(st, 4))
+		sd->head_dir = static_cast<uint8>(script_getnum(st, 4) % 3);
+	clif_changed_dir(*sd, AREA);
+	script_pushint(st, 1);
+	return SCRIPT_CMD_SUCCESS;
+}
+
+/**
+ * population_respawn(<gid>, <ms>)
+ *   How long this shell's body lies the next times it dies: ms, 0 the battle config's
+ *   delay (population_engine_respawn_min_ms / _max_ms), -1 never: it stays down until
+ *   population_revive or population_despawn. 1 done, 0 not an ambient shell.
+ */
+BUILDIN_FUNC(population_respawn)
+{
+	map_session_data *sd = map_id2sd(script_getnum(st, 2));
+	if (sd == nullptr || population_engine_shell_kind(sd->id) != POP_SHELL_AMBIENT) {
+		script_pushint(st, 0);
+		return SCRIPT_CMD_SUCCESS;
+	}
+	sd->pop.respawn_ms = std::max(-1, script_getnum(st, 3));
+	script_pushint(st, 1);
+	return SCRIPT_CMD_SUCCESS;
+}
+
+/**
+ * population_revive(<gid>{, "<map>", <x>, <y>})
+ *   Stands a dead shell up again, at full HP and SP: where it lies, or on the map and
+ *   cell given (its save point, a portal it walks in from). 1 done, 0 not a dead shell.
+ */
+BUILDIN_FUNC(population_revive)
+{
+	int16 m = -1, x = 0, y = 0;
+	if (script_hasdata(st, 3)) {
+		m = map_mapname2mapid(script_getstr(st, 3));
+		if (m < 0) {
+			ShowWarning("buildin_population_revive: Unknown map '%s'.\n", script_getstr(st, 3));
+			script_pushint(st, 0);
+			return SCRIPT_CMD_SUCCESS;
+		}
+		x = static_cast<int16>(script_hasdata(st, 4) ? script_getnum(st, 4) : 0);
+		y = static_cast<int16>(script_hasdata(st, 5) ? script_getnum(st, 5) : 0);
+	}
+	script_pushint(st, population_engine_shell_revive(script_getnum(st, 2), m, x, y) ? 1 : 0);
+	return SCRIPT_CMD_SUCCESS;
+}
+
+/**
+ * population_guild("<name>", <n 1-9999>, "<master>"{, "<emblem BMP as hex>"{, "<Title0|Title1|...>"}})
+ *   Makes (or updates) shell guild n, kept only in the map server: it is never saved and
+ *   real players cannot join it. Returns its guild id (1900000000 + n), 0 if n is out of range.
+ *   Make them again in OnInit; members and alliances are not kept across restarts.
+ * population_guild_join(<gid>, <guild id>{, <title index>})
+ *   Puts a shell in it: name, title and emblem show over its head; GvG/WoE treat it as that
+ *   guild. 1 done, 0 not a shell, not a shell guild, the shell is in a real guild, or full.
+ * population_guild_leave(<gid>)
+ * population_guild_ally(<guild id>, <guild id>, <0 ally, 1 enemy, -1 drop>)
+ */
+BUILDIN_FUNC(population_guild)
+{
+	const char *emb = script_hasdata(st, 5) ? script_getstr(st, 5) : "";
+	const char *pos = script_hasdata(st, 6) ? script_getstr(st, 6) : "";
+	script_pushint(st, population_guild_define(script_getnum(st, 3), script_getstr(st, 2),
+		script_getstr(st, 4), emb, pos));
+	return SCRIPT_CMD_SUCCESS;
+}
+
+BUILDIN_FUNC(population_guild_join)
+{
+	script_pushint(st, population_guild_join(script_getnum(st, 2), script_getnum(st, 3),
+		script_hasdata(st, 4) ? script_getnum(st, 4) : 2));
+	return SCRIPT_CMD_SUCCESS;
+}
+
+BUILDIN_FUNC(population_guild_leave)
+{
+	map_session_data *sd = map_id2sd(script_getnum(st, 2));
+	bool ok = sd != nullptr && population_engine_shell_kind(sd->id) != 0 && population_guild_leave(sd, true);
+	script_pushint(st, ok ? 1 : 0);
+	return SCRIPT_CMD_SUCCESS;
+}
+
+BUILDIN_FUNC(population_guild_ally)
+{
+	const int how = script_getnum(st, 4);
+	script_pushint(st, population_guild_alliance(script_getnum(st, 2), script_getnum(st, 3),
+		how > 0 ? 1 : 0, how >= 0) ? 1 : 0);
+	return SCRIPT_CMD_SUCCESS;
+}
+
+/**
+ * population_war(<gid>, <1 on, 0 off>)
+ *   War mode for an ambient shell: it becomes mortal and fights whoever the map's rules
+ *   make its enemy (other guilds on GvG/WoE maps, everyone outside its guild on PvP maps),
+ *   real players included, and breaks the Emperium on GvG maps. Its heals and buffs go to
+ *   its guild and allies only; when it dies on a PvP or GvG map the engine (and the death
+ *   event) bring it back, not the save point. Off puts it back as it was. 1 done, 0 not an
+ *   ambient shell.
+ */
+BUILDIN_FUNC(population_war)
+{
+	script_pushint(st, population_engine_shell_set_war(script_getnum(st, 2), script_getnum(st, 3) != 0) ? 1 : 0);
+	return SCRIPT_CMD_SUCCESS;
+}
+
+/**
+ * population_death_event("<npc>::<label>")
+ *   Runs that label whenever an ambient shell dies, with $@pop_dead_gid set to it, before
+ *   the engine decides when it stands up. "" turns it off.
+ */
+BUILDIN_FUNC(population_death_event)
+{
+	population_engine_set_death_event(script_getstr(st, 2));
+	return SCRIPT_CMD_SUCCESS;
+}
+
+/**
+ * population_chat_event("<npc>::<label>")
+ *   Runs that label, attached to the player, whenever a real player says something in
+ *   public chat (not in an NPC dialog); @pop_chat$ is what they said. "" turns it off.
+ */
+BUILDIN_FUNC(population_chat_event)
+{
+	population_engine_set_public_chat_event(script_getstr(st, 2));
+	return SCRIPT_CMD_SUCCESS;
+}
+
+/**
+ * population_chatroom(<gid>, "<title>", <limit>{, <public 1/0>})
+ *   Opens a chat room owned by the shell, as a player opens one (Alt+C): the room's
+ *   sign over its head, the player's icon, anyone can walk in. 1 opened.
+ * population_chatroom_close(<gid>)
+ *   Closes it (the shell leaves its own room). 1 closed.
+ */
+BUILDIN_FUNC(population_chatroom)
+{
+	map_session_data *sd = map_id2sd(script_getnum(st, 2));
+	if (sd == nullptr || population_engine_shell_kind(sd->id) == 0 || sd->chatID != 0) {
+		script_pushint(st, 0);
+		return SCRIPT_CMD_SUCCESS;
+	}
+	const int32 limit = cap_value(script_getnum(st, 4), 2, 20);
+	const bool pub = script_hasdata(st, 5) ? script_getnum(st, 5) != 0 : true;
+	chat_createpcchat(sd, script_getstr(st, 3), "", limit, pub);
+	script_pushint(st, sd->chatID != 0 ? 1 : 0);
+	return SCRIPT_CMD_SUCCESS;
+}
+
+BUILDIN_FUNC(population_chatroom_close)
+{
+	map_session_data *sd = map_id2sd(script_getnum(st, 2));
+	if (sd == nullptr || population_engine_shell_kind(sd->id) == 0 || sd->chatID == 0) {
+		script_pushint(st, 0);
+		return SCRIPT_CMD_SUCCESS;
+	}
+	chat_leavechat(sd, 0);
+	script_pushint(st, 1);
+	return SCRIPT_CMD_SUCCESS;
+}
+
 BUILDIN_FUNC(population_is_shell)
 {
 	script_pushint(st, population_engine_shell_kind(script_getnum(st, 2)));
