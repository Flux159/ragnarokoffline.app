+	// of hunting the world for a matching ambient character.
+	if (strcmpi(cmd, "draft") == 0 || strcmpi(cmd, "create") == 0) {
+		if (!param[0]) {
+			clif_displaymessage(fd, "Usage: @companion draft <job name or id> [name]");
+			return -1;
