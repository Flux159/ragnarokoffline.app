+			snprintf(msg, sizeof(msg), "Unknown job '%s'. Try @companion jobs for the list.", jobtok);
+			clif_displaymessage(fd, msg);
+			return -1;
+		}
+		if (!population_engine_can_recruit_companion(sd)) {
+			clif_displaymessage(fd, "Your party is at the companion limit.");
+			return -1;
+		}
+		// A duplicate name would collide with the saved list, so a drafted
+		// companion gets a generated name when none was given.
+		char chosen[NAME_LENGTH] = {0};
+		if (parsed >= 2 && nametok[0]) {
+			uint32_t dup_index = 0; bool dup_active = false;
+			if (population_engine_companion_find(sd->status.account_id, nametok, &dup_index, &dup_active)) {
+				clif_displaymessage(fd, "You already have a companion by that name.");
+				return -1;
