+		clif_displaymessage(fd, "2nd: Knight Priest Wizard Blacksmith Hunter Assassin Crusader Monk Sage Rogue Alchemist Bard Dancer");
+		clif_displaymessage(fd, "Trans: LordKnight HighPriest HighWizard Whitesmith Sniper AssassinCross Paladin Champion Professor Stalker Creator Clown Gypsy");
