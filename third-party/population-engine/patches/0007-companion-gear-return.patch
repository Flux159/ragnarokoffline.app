From 0000000000000000000000000000000000000003
Subject: [PATCH] Goal 2 gear return: @companion gear <name> - unequip all worn gear from a summoned companion and hand it to the owner

Adds population_engine_companion_return_gear(owner, shell) (pc_unequipitem flag 2 per equipped slot, then pc_additem to the owner; drops at feet when overweight) and a gear subcommand in the @companion atcommand so players can take equipment back without a trade window (deals cannot reference equipped slots).

diff --git a/src/custom/atcommand.inc b/src/custom/atcommand.inc
--- a/src/custom/atcommand.inc
+++ b/src/custom/atcommand.inc
@@ -221,15 +221,73 @@
 /* @companion — manage saved (Goal 1/3) companions: list / favorite / summon.
  * Companions persist in cp_companion_persistence; expelled ones stay there
  * inactive and can be re-summoned by name with their exact saved identity. */
+/// Resolve the companion named at the START of `text`, longest match first.
+///
+/// @param account_id  owner whose saved list to search
+/// @param text        the argument remainder (may be just a name, or a name plus
+///                    further arguments joined by spaces)
+/// @param out_name    receives the matched name
+/// @param out_name_len size of out_name
+/// @param out_tail    receives the remaining text after the name (may be empty)
+/// @param out_tail_len size of out_tail
+/// @return true when a saved companion matched.
+///
+/// Longest-prefix matching is what makes `@companion gear Talivis armor` work: the
+/// name is the longest leading run of words that exists in the player's list, and
+/// everything after it is the slot list. A single whitespace split cannot do this,
+/// which is why the old form only worked for one-word names with no extra arguments.
+static bool companion_resolve_name_and_tail(uint32_t account_id, const char *text,
+	char *out_name, size_t out_name_len, char *out_tail, size_t out_tail_len)
+{
+	if (text == nullptr || out_name == nullptr || out_tail == nullptr || out_name_len == 0 || out_tail_len == 0)
+		return false;
+	out_name[0] = '\0';
+	out_tail[0] = '\0';
+
+	const size_t len = strlen(text);
+	// Walk the break points between words, from the END backwards, so the first
+	// successful lookup is the longest candidate.
+	for (size_t cut = len; cut > 0; --cut) {
+		if (cut < len && text[cut] != ' ')
+			continue; // only consider cuts at a word boundary
+		size_t end = cut;
+		while (end > 0 && text[end - 1] == ' ')
+			--end; // trim trailing spaces from the candidate
+		if (end == 0)
+			continue;
+		char candidate[NAME_LENGTH];
+		const size_t n = end < (out_name_len - 1) ? end : (out_name_len - 1);
+		safestrncpy(candidate, text, n + 1);
+		uint32_t idx = 0; bool act = false;
+		if (!population_engine_companion_find(account_id, candidate, &idx, &act))
+			continue; // not a name: try a shorter prefix
+		safestrncpy(out_name, candidate, out_name_len);
+		// Everything after the name (skipping the separating spaces) is the tail.
+		size_t tail = cut;
+		while (tail < len && text[tail] == ' ')
+			++tail;
+		safestrncpy(out_tail, text + tail, out_tail_len);
+		return true;
+	}
+	return false;
+}
