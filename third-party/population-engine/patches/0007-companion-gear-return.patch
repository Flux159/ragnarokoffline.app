+		if (!param[0] || !companion_resolve_name_and_tail(sd->status.account_id, param, del_name, sizeof(del_name), del_tail, sizeof(del_tail))) {
 			clif_displaymessage(fd, "Usage: @companion remove <name>");
 			return -1;
 		}
