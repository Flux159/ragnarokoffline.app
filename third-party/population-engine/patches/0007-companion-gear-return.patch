+					else if (!strcmpi(tok, "shield"))   mask |= EQP_HAND_L;
+					else if (!strcmpi(tok, "armor"))    mask |= EQP_ARMOR;
+					else if (!strcmpi(tok, "shoes"))    mask |= EQP_SHOES;
+					else if (!strcmpi(tok, "garment"))  mask |= EQP_GARMENT;
+					else if (!strcmpi(tok, "acc"))      mask |= EQP_ACC_RL;
+					else if (!strcmpi(tok, "accl"))     mask |= EQP_ACC_L;
+					else if (!strcmpi(tok, "accr"))     mask |= EQP_ACC_R;
+					else if (!strcmpi(tok, "head"))     mask |= EQP_HELM;
+					else if (!strcmpi(tok, "headtop"))  mask |= EQP_HEAD_TOP;
+					else if (!strcmpi(tok, "headmid"))  mask |= EQP_HEAD_MID;
+					else if (!strcmpi(tok, "headlow"))  mask |= EQP_HEAD_LOW;
+					else if (!strcmpi(tok, "costume"))  mask |= EQP_COSTUME;
+					else if (!strcmpi(tok, "shadow"))   mask |= EQP_SHADOW_GEAR;
+					else if (!strcmpi(tok, "ammo"))     mask |= EQP_AMMO;
+					else {
+						char msg[128];
+						snprintf(msg, sizeof(msg), "Unknown slot '%s' — use: weapon shield armor shoes garment acc accl accr head headtop headmid headlow costume shadow ammo", tok);
+						clif_displaymessage(fd, msg);
+						return -1;
+					}
+				}
+			}
+		}
+		const int moved = population_engine_companion_return_gear(sd, live, mask);
+		char msg[96];
+		if (moved >= 0)
+			snprintf(msg, sizeof(msg), "Returned %d item(s) from %s.", moved, gear_name);
+		else
+			snprintf(msg, sizeof(msg), "Could not return gear from %s.", gear_name);
+		clif_displaymessage(fd, msg);
+		return 0;
+	}
+	if (strcmpi(cmd, "remove") == 0 || strcmpi(cmd, "delete") == 0) {
