diff --git a/src/custom/battle_config_struct.inc b/src/custom/battle_config_struct.inc
index 03e5b76..4c88470 100644
--- a/src/custom/battle_config_struct.inc
+++ b/src/custom/battle_config_struct.inc
@@ -13,6 +13,20 @@
  **/
 
 
+/// Master switch. Off by default: a solo world with no shells in it is a
+/// legitimate thing to want, and the engine costs ~0.4 MB of RAM per shell.
+int32 population_engine_enable;
+/// Fill only the maps real players are on, rather than every map named in
+/// population_spawn.yml. See the RAGNAROKMAC block in population_engine.cpp.
+int32 population_engine_demand_spawn;
+/// How long a map keeps its shells after the last real player leaves.
+int32 population_engine_demand_grace_ms;
+/// Percentage applied to every spawn-table population before it is
+/// distributed across a map list. 100 = exactly what the YAML asks for.
+int32 population_engine_density_pct;
+/// Take a shell's level from the monsters on its map, within the range its
+/// profile declares. Lets a mod add a map without curating levels for it.
+int32 population_engine_level_from_map;
 int32 population_engine_max_count;
 /// 0 = warn and fix invalid YAML rows; 1 = discard entire equipment DB if any validation error
 int32 population_engine_equipment_strict_load;
