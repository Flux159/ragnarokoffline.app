# Generated into the RemoteClient-JS runtime by scripts/link-assets.sh.
# DATA_OVERRIDE_PATH is rewritten there to an absolute path.
PORT=3338
CLIENT_PUBLIC_URL=http://127.0.0.1:3338
NODE_ENV=production

ENABLE_STATIC_SERVE=true
ENABLE_WSPROXY=true
ROBROWSER_PATH=../roBrowserLegacy/dist/Web

WS_ALLOWED_TARGETS=127.0.0.1:6900,127.0.0.1:6121,127.0.0.1:5121

CACHE_MAX_FILES=5000
CACHE_MAX_MEMORY_MB=1024
CACHE_WARM_UP=false
