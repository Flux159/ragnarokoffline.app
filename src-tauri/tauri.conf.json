{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RagnarokMac",
  "version": "0.1.0",
  "identifier": "com.ragnarokmac.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "game",
        "title": "Ragnarok Offline",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}